# Server & Public URL
PORT=8080
APP_URL=http://localhost:8080
ALLOWED_ORIGINS=*
STATIC_DIR=./static

# Database (sqlite or postgres)
DB_DRIVER=sqlite
DB_DSN=./data/support.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=postgres://user:password@localhost:5432/support_db?sslmode=disable

# Telegram Bot Credentials
# Получить токен у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# ID супергруппы (начинается с -100..., можно узнать через @userinfobot или в ссылке топика)
TELEGRAM_CHAT_ID=-1001234567890

# Режим работы Telegram: 'polling' (по умолчанию, не требует HTTPS/домена) или 'webhook'
TELEGRAM_MODE=polling
# Если TELEGRAM_MODE=webhook, укажите публичный HTTPS адрес вебхука:
# WEBHOOK_URL=https://chat.yourdomain.com/api/v1/support/telegram/webhook

# Опционально: SMTP настройки для отправки ответов пользователям на email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
