  "devDependencies": {
    "@types/node": "^22.0.0",
    "preact": "^10.22.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-css-injected-by-js": "^3.5.1"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
