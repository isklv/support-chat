{
  "name": "support-chat-widget",
  "version": "1.0.0",
  "description": "Embeddable feedback and support chat widget with Telegram bot integration",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build:embed": "vite build --mode embed",
